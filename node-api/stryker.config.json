{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.properties.config.js",
    "enableFindRelatedTests": false
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/domain/**/*.js"
  ],
  "reporters": [
    "json",
    "clear-text",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 2,
  "timeoutMS": 4000,
  "cleanTempDir": true,
  "disableBail": true
}