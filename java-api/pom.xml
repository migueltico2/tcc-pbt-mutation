<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>br.pucminas.tcc</groupId>
    <artifactId>ingressos-java</artifactId>
    <version>1.0.0</version>
    <name>ingressos-java</name>
    <description>API REST de eventos e reservas de ingressos (Java/Spring Boot) - TCC PBT x Mutation Testing</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versões usadas no experimento (ver README) -->
        <jqwik.version>1.7.4</jqwik.version>
        <pitest.version>1.18.2</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pit.targetTests>br.pucminas.tcc.ingressos.properties.PropriedadesPrecoTest,br.pucminas.tcc.ingressos.properties.PropriedadesDisponibilidadeTest,br.pucminas.tcc.ingressos.properties.PropriedadesStatusTest</pit.targetTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Cobertura da suíte de propriedades: mvn test -Pcobertura-propriedades -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <includes>
                        <include>br/pucminas/tcc/ingressos/domain/**</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Mutação: mvn test-compile org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- D1: só o domínio é mutado; D7: só a suíte de propriedades é usada -->
                    <targetClasses>
                        <param>br.pucminas.tcc.ingressos.domain.*</param>
                    </targetClasses>
                    <!-- Suíte fraca (P1–P8) por padrão; suíte forte (P1–P17) com -Psuite-forte -->
                    <targetTests>${pit.targetTests}</targetTests>
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                    </mutators>
                    <outputFormats>
                        <format>XML</format>
                        <format>CSV</format>
                        <format>HTML</format>
                    </outputFormats>
                    <fullMutationMatrix>true</fullMutationMatrix>
                    <timestampedReports>false</timestampedReports>
                    <threads>2</threads>
                    <timeoutConstant>4000</timeoutConstant>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Suíte forte na mutação: mvn test-compile org.pitest:pitest-maven:mutationCoverage -Psuite-forte -->
        <profile>
            <id>suite-forte</id>
            <properties>
                <pit.targetTests>br.pucminas.tcc.ingressos.properties.*</pit.targetTests>
            </properties>
        </profile>
        <!-- Só a suíte de propriedades (mesma suíte medida na mutação) -->
        <profile>
            <id>cobertura-propriedades</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>br/pucminas/tcc/ingressos/properties/**</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
